# Runtime variables currently read by the application. Node commands must load
# this file explicitly, for example: node --env-file=.env apps/api/server.mjs.
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Relative paths are resolved from the process working directory.
DATA_FILE=apps/api/data/development.sqlite
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Development defaults to demo users; production units explicitly disable them.
SEED_DEMO_USERS=
# Enable only when the API receives traffic through a trusted loopback proxy.
TRUST_PROXY=false
# Defaults to true in production; set false only in an explicit HTTP-only LAN unit.
# Leave blank here so NODE_ENV=production retains the secure default.
COOKIE_SECURE=

# Backup script defaults. Set production values in the systemd unit/environment.
BACKUP_DIR=apps/api/data/backups
BACKUP_RETENTION=14
