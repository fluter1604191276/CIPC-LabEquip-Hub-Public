[Unit]
Description=CIPC LabEquip Hub API
After=network.target

[Service]
Type=simple
User=cipc-labequip
Group=cipc-labequip
WorkingDirectory=/opt/cipc-labequip/current
Environment=NODE_ENV=production
Environment=API_PORT=4000
Environment=DATA_FILE=/var/lib/cipc-labequip/data/production.sqlite
Environment=CORS_ORIGINS=https://equip.labequip.example.edu
Environment=SEED_DEMO_USERS=false
Environment=TRUST_PROXY=true
Environment=COOKIE_SECURE=true
Environment=BACKUP_DIR=/var/lib/cipc-labequip/backups
Environment=BACKUP_RETENTION=14
Environment=APP_VERSION=1.4.7
Environment=UPDATE_ENABLED=true
Environment=UPDATE_REPOSITORY=fluter1604191276/CIPC-LabEquip-Hub-Public
Environment=UPDATE_REQUEST_FILE=/var/lib/cipc-labequip/data/upgrade/request.json
Environment=UPDATE_STATUS_FILE=/var/lib/cipc-labequip/data/upgrade/status.json
ExecStart=/usr/local/bin/node apps/api/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/cipc-labequip

[Install]
WantedBy=multi-user.target
