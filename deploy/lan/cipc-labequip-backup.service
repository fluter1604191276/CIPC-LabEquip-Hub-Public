[Unit]
Description=CIPC LabEquip Hub verified SQLite backup (LAN)
After=cipc-labequip-api.service

[Service]
Type=oneshot
User=cipc-labequip
Group=cipc-labequip
WorkingDirectory=/opt/cipc-labequip/current
Environment=DATA_FILE=/var/lib/cipc-labequip/data/production.sqlite
Environment=BACKUP_DIR=/var/lib/cipc-labequip/backups
Environment=BACKUP_RETENTION=14
ExecStart=/usr/bin/node scripts/backup-db.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cipc-labequip/data
ReadWritePaths=/var/lib/cipc-labequip/backups
